auto test_entry = []() -> i32 {
  auto apply = [](callback: [](i32) -> i32, value: i32) -> i32 {
    return callback(value);
  };
  auto transform = [](value: i32) -> i32 {
    return value + 1_i32;
  };
  auto result = apply(transform, 20_i32);
  if (true) {
    auto transform = [](value: u8) -> u8 {
      return value + 2_u8;
    };
    result = result + #cast(i32, transform(18_u8));
  }
  return result + transform(0_i32);
}
