auto increment = [](value: i32) -> i32 {
  return value + 1_i32;
}

auto apply = [](callback: [](i32) -> i32, value: i32) -> i32 {
  return callback(value);
}

auto test_entry = []() -> i32 {
  auto twice = [](value: i32) -> i32 {
    return increment(value * 2_i32);
  };
  return apply(increment, 20_i32) + apply(twice, 10_i32);
}
