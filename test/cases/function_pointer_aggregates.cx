struct FunctionPair {
  first: fn(i32) -> i32,
  second: fn(i32) -> i32
}

struct Runner {
  run: fn(i32) -> i32
}

fn increment(value: i32) -> i32 {
  return value + 1_i32;
}

fn double(value: i32) -> i32 {
  return value * 2_i32;
}

fn test_entry() -> i32 {
  auto functions = [increment, double];
  auto pair = FunctionPair { first: functions[0_i32], second: functions[1_i32] };
  auto record = Runner { run: pair.first };
  record.run = pair.second;
  return functions[0_i32](3_i32) + functions[1_i32](4_i32) +
         pair.first(5_i32) + pair.second(6_i32) + record.run(6_i32);
}
