fn test_entry() -> i32 {
  auto outer = 0_i32;
  auto count = 0_i32;
  loop {
    outer = outer + 1_i32;
    if (outer > 3_i32) { break; }
    auto inner = 0_i32;
    loop {
      inner = inner + 1_i32;
      if (inner == 2_i32) { continue; }
      if (inner == 4_i32) { break; }
      count = count + 1_i32;
    }
  }
  return count;
}
