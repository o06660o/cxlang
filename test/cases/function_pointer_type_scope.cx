fn apply(callback: fn(i32) -> i32, value: i32) -> i32 {
  return callback(value);
}

fn transform(value: i32) -> i32 {
  return value + 1_i32;
}

fn transform_u8(value: u8) -> u8 {
  return value + 2_u8;
}

fn test_entry() -> i32 {
  auto result = apply(transform, 20_i32);
  if (true) {
    auto transform = transform_u8;
    result = result + #cast(i32, transform(18_u8));
  }
  return result + transform(0_i32);
}
