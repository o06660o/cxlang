fn empty(value: [u8; 0]) -> i32 {
  return 1_i32;
}

fn is_utf8(value: [u8; 3]) -> bool {
  return value[0_i32] == 228_u8 &&
         value[1_i32] == 184_u8 &&
         value[2_i32] == 173_u8;
}

fn main() -> i32 {
  auto text = "中";
  auto valid = is_utf8(text);
  text[0_i32] = 65_u8;
  if (valid && text[0_i32] == 65_u8) {
    return empty("");
  }
  return 0_i32;
}
