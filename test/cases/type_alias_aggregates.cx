using Record = {left: i32; right: i32}
using Pair = Record
using Records = [Pair; 2]

auto sum = [](values: Records) -> i32 {
  return values[0_i32].left + values[0_i32].right +
         values[1_i32].left + values[1_i32].right;
}

auto test_entry = []() -> i32 {
  auto values = [{left: 2_i32, right: 3_i32}, {left: 5_i32, right: 7_i32}];
  values[1_i32].right = 11_i32;
  return sum(values);
}
