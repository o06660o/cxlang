struct Pair {
  first: i32,
  second: i32
}

struct Value {
  items: [i32; 3],
  pair: Pair
}

fn test_entry() -> i32 {
  auto value = Value {
    items: [1_i32, 2_i32, 3_i32],
    pair: Pair { first: 4_i32, second: 5_i32 }
  };
  value.items[1_i32] = 8_i32;
  return value.items[0_i32] + value.items[1_i32] + value.pair.first + value.pair.second;
}
